<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox (REQUIRED for App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Team ID will be added during signing -->
    <key>com.apple.application-identifier</key>
    <string>$(AppIdentifierPrefix)com.coredeck.CoreDeck</string>

    <key>com.apple.developer.team-identifier</key>
    <string>$(TeamIdentifierPrefix)</string>

    <!-- USB/HID Device Access -->
    <key>com.apple.security.device.usb</key>
    <true/>

    <!-- Network access. The daemon binds an HTTP/WS server on
         127.0.0.1:19384, so network.server is required (it was missing —
         under the sandbox the daemon couldn't listen). network.client is
         for the GitHub update checker. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access - User selected files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- A pure-Rust daemon doesn't run unsigned/JIT code, so the
         cs.allow-unsigned-executable-memory relaxation (which weakens the
         hardened runtime) was removed to match the distribution
         entitlements. -->
</dict>
</plist>
