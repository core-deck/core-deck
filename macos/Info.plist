<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Basic App Identity -->
    <key>CFBundleName</key>
    <string>Core Deck</string>

    <key>CFBundleDisplayName</key>
    <string>Core Deck</string>

    <key>CFBundleIdentifier</key>
    <string>com.coredeck.CoreDeck</string>

    <key>CFBundleVersion</key>
    <string>0.2.1</string>

    <key>CFBundleShortVersionString</key>
    <string>0.2.1</string>

    <key>CFBundleExecutable</key>
    <string>coredeck</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <!-- macOS Specific -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- Tray-only app: no Dock icon, no app menu. Required for the
         daemon, which has no GUI. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Required for background execution -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Privacy Permission Descriptions. The daemon doesn't capture
         keystrokes (F-key events arrive over HID from the macropad,
         not via global keyboard monitoring), but it does send Apple
         Events to raise the focused wrapper's host terminal. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Core Deck raises the focused Claude wrapper's terminal window when you press F20 or cycle tabs.</string>

    <!-- Copyright -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Core Deck. Licensed under GPL-3.0-or-later.</string>

    <!-- Application Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!-- Supported Architectures -->
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
    </array>
</dict>
</plist>
